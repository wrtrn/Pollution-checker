# Copy this file to `.env` (for local runs) and fill in real values.
# In production, place these into /etc/pollution-checker/env (mode 0600) and load via systemd EnvironmentFile.

# Telegram bot token from @BotFather
BOT_TOKEN=123456789:ABCDEFghijklmnopQRSTUVwxyz

# Main channel — pollution level changes and high-level trend notifications.
# For channels, the id is negative and starts with -100. The bot must be an admin of the channel.
CHANNEL_ID=-1001234567890

# Error channel — site-down / site-recovered notifications.
# Must be a separate Telegram channel where the bot is also an admin.
ERROR_CHANNEL_ID=-1009876543210

# Path to the JSON file that holds bot state between runs.
#   * In production (systemd), DO NOT set this here — the systemd unit pins
#     it to /var/lib/pollution-checker/state.json. Setting STATE_FILE in this
#     file would override the unit and break the read-only-filesystem
#     protection (the bot would try to write into /opt/pollution-checker).
#   * For local development, uncomment and set whatever path you like.
# STATE_FILE=./pollution_state.json

# Optional: healthchecks.io (or similar) ping URL for dead-man's switch monitoring.
# Pings on success, and pings /fail on scrape errors.
HEALTHCHECK_URL=

# Optional: dry-run mode. If set to "1", messages are logged but not sent to Telegram.
DRY_RUN=0

# Optional: log level (DEBUG, INFO, WARNING, ERROR). Default: INFO.
LOG_LEVEL=INFO
